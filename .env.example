# ============================================================
#  MeuLead — variáveis de ambiente
#  Copie este arquivo para ".env" e preencha os COLE_AQUI.
#  Veja COMECE-AQUI.md para saber onde pegar cada valor.
# ============================================================

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=COLE_AQUI
NEXT_PUBLIC_SUPABASE_ANON_KEY=COLE_AQUI
SUPABASE_SERVICE_ROLE_KEY=COLE_AQUI          # 🔒 secreto — só no servidor
SUPABASE_DB_URL=COLE_AQUI                    # postgresql://... (migrations)

# --- Apify ---
APIFY_TOKEN=COLE_AQUI

# --- Evolution API (sua VPS) ---
EVOLUTION_API_URL=COLE_AQUI
EVOLUTION_API_KEY=COLE_AQUI

# --- n8n (sua VPS) ---
N8N_WEBHOOK_URL=COLE_AQUI
N8N_WEBHOOK_SECRET=COLE_AQUI                 # senha que você inventa

# --- App ---
APP_URL=http://localhost:3000
